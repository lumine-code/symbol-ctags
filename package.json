{
  "name": "symbol-ctags",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides symbols via universal-ctags.",
  "keywords": [
    "navigation",
    "tags-file",
    "declaration",
    "outline",
    "universal-ctags"
  ],
  "repository": "https://github.com/lumine-code/symbol-ctags",
  "bugs": {
    "url": "https://github.com/lumine-code/symbol-ctags/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "vendor"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "useEditorGrammarAsCtagsLanguage": {
      "title": "Use Editor Grammar As Ctags Language",
      "description": "Force `ctags` to use the name of the current file's language in Lumine when generating tags. By default, `ctags` automatically selects the language of a source file, ignoring those files whose language cannot be determined. This option forces the specified language to be used instead of automatically selecting the language based upon its extension.",
      "type": "boolean",
      "default": true
    }
  },
  "providedServices": {
    "symbol.provider": {
      "description": "Allows external sources to suggest symbols for a given file or project.",
      "versions": {
        "1.0.0": "provideSymbol"
      }
    }
  },
  "dependencies": {
    "@lumine-code/ctags": "github:lumine-code/node-ctags#46547ad57ef5a8462ad8e29ce67c51d24553d0c5",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#dbede762a7a1019a024d8f8c8de5e4f04ef2bd78",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#3187fd4c2dd47f50044efe51deb7c662ddac437c",
    "async": "3.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#5d0a30ffb4d68f21577d057aef8844a55479e304",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
