{
  "name": "symbol-ctags",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides symbols via universal-ctags.",
  "keywords": [
    "navigation",
    "tags-file",
    "declaration",
    "outline",
    "universal-ctags"
  ],
  "repository": "https://github.com/lumine-code/symbol-ctags",
  "bugs": {
    "url": "https://github.com/lumine-code/symbol-ctags/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "vendor"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "specPackages": [
    "language-ruby"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "useEditorGrammarAsCtagsLanguage": {
      "title": "Use Editor Grammar As Ctags Language",
      "description": "Force `ctags` to use the name of the current file's language in Lumine when generating tags. By default, `ctags` automatically selects the language of a source file, ignoring those files whose language cannot be determined. This option forces the specified language to be used instead of automatically selecting the language based upon its extension.",
      "type": "boolean",
      "default": true
    }
  },
  "providedServices": {
    "symbol.provider": {
      "description": "Allows external sources to suggest symbols for a given file or project.",
      "versions": {
        "1.0.0": "provideSymbol"
      }
    }
  },
  "dependencies": {
    "@lumine-code/ctags": "github:lumine-code/node-ctags#3c79cc6ab165ad4fc13d7002e305cb96f733612d",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#d864d8178848421b65132e5992398c84ec4e64df",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#fd9c48ac852a303e1fbc2e1ae77dbefa57ba6052",
    "async": "3.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#bbd9e24a78e835e7421c8acec360731eafa4d3f6",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
