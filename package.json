{
  "name": "symbol-ctags",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides symbols via universal-ctags.",
  "keywords": [
    "navigation",
    "tags-file",
    "declaration",
    "outline",
    "universal-ctags"
  ],
  "repository": "https://github.com/lumine-code/symbol-ctags",
  "bugs": {
    "url": "https://github.com/lumine-code/symbol-ctags/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "vendor"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "specPackages": [
    "language-ruby"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "useEditorGrammarAsCtagsLanguage": {
      "title": "Use Editor Grammar As Ctags Language",
      "description": "Force `ctags` to use the name of the current file's language in Lumine when generating tags. By default, `ctags` automatically selects the language of a source file, ignoring those files whose language cannot be determined. This option forces the specified language to be used instead of automatically selecting the language based upon its extension.",
      "type": "boolean",
      "default": true
    }
  },
  "providedServices": {
    "symbol.provider": {
      "description": "Allows external sources to suggest symbols for a given file or project.",
      "versions": {
        "1.0.0": "provideSymbol"
      }
    }
  },
  "dependencies": {
    "@lumine-code/ctags": "github:lumine-code/node-ctags#bd126f8d9895b8c8365c35becf8bceb1b1bd8c26",
    "@lumine-code/fs-plus": "github:lumine-code/fs-plus#83486ac8a670adb4381a9d4e2df3eb999f670ad1",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#1577303f839c11bd8d83d7fbe3cef8dd9219bfbb",
    "async": "3.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#d952dc119d4dda6918a37c414302e6eb1dc9789d",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "language-ruby": "github:lumine-code/language-ruby#2d2ae35837a99b6ad4a28a5f392c820c690096c7",
    "prettier": "^3.9.9"
  }
}
